# Copy to .env.local and adjust. Never commit real credentials.

# Local Docker database (see docker-compose.yml):
DATABASE_URL=postgres://supportpilot:supportpilot@localhost:5432/supportpilot

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth App (local app: callback http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins that get the Lead role; everyone else is an Engineer.
LEAD_GITHUB_LOGINS=

# Test login for local development and Playwright only. Ignored when VERCEL_ENV=production.
# AUTH_TEST_LOGIN=enabled
